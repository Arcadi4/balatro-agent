{
  "name": "balatro-agent",
  "private": true,
  "workspaces": [
    "mcp"
  ],
  "type": "module",
  "scripts": {
    "help": "vpx ./scripts/help.ts",
    "doctor": "vpx ./scripts/doctor.ts",
    "install:mods": "vpx ./scripts/install-mods.ts",
    "run": "vpx ./scripts/run.ts",
    "bump": "vpx ./scripts/bump.ts",
    "dev": "bun --cwd=mcp run dev",
    "build": "bun --cwd=mcp run build",
    "typecheck": "bun --bun tsc --noEmit -p . && bun --cwd=mcp run typecheck",
    "test": "bun --cwd=mcp run test",
    "format": "bun --bun vp fmt scripts package.json tsconfig.json && bun --cwd=mcp run format",
    "build:release": "bun --cwd=mcp run build:release",
    "release:setup": "bun --cwd=mcp run release:setup",
    "ci:nexus": "vpx ./scripts/ci/nexus-metadata.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.7.0"
  },
  "packageManager": "bun@1.4.4"
}
