{
  "name": "balatro-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Balatro mod development",
  "license": "MIT",
  "author": "4rcadia",
  "type": "module",
  "bin": {
    "balatro-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcadi4/balatro-agent.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/Arcadi4/balatro-agent/tree/main/mcp#readme",
  "bugs": "https://github.com/Arcadi4/balatro-agent/issues",
  "keywords": [
    "balatro",
    "mcp",
    "modelcontextprotocol",
    "steamodded",
    "lovely"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target=node --sourcemap=external",
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "prepublishOnly": "npm run typecheck && bun test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "oxfmt": "^0.63.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
