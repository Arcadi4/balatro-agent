{
  "name": "balatro-mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server for Balatro mod development",
  "license": "MIT",
  "author": "4rcadia",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target=node --sourcemap=external",
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "oxfmt": "^0.63.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
