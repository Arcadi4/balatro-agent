{
  "name": "balatro-mcp",
  "version": "0.2.7",
  "private": true,
  "description": "MCP server connecting AI agents to play Balatro",
  "keywords": [
    "agent",
    "ai",
    "ai-agent",
    "balatro",
    "lovely",
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "smods",
    "steamodded"
  ],
  "homepage": "https://www.nexusmods.com/balatro/mods/927",
  "bugs": {
    "url": "https://github.com/Arcadi4/balatro-agent/issues"
  },
  "license": "MIT",
  "author": {
    "name": "4rcadia",
    "url": "https://github.com/Arcadi4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcadi4/balatro-agent.git",
    "directory": "mcp"
  },
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "bun --bun tsc --noEmit -p .",
    "test": "bun test",
    "format": "bun --bun vp fmt package.json vite.config.ts src scripts",
    "build:release": "bun run scripts/build.ts --release",
    "release:setup": "bun run scripts/setup-release.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.4"
}
